# cadastro.py

pessoas = []

def cadastrar():
    nome = input("Digite o nome: ")
    email = input("Digite o email: ")
    idade = int(input("Digite a idade: "))
    pessoa = {"nome": nome, "email": email, "idade": idade}
    pessoas.append(pessoa)
    print("Pessoa cadastrada com sucesso!\n")

def listar():
    if not pessoas:
        print("Nenhuma pessoa cadastrada.\n")
    else:
        for i, p in enumerate(pessoas):
            print(f"{i} - Nome: {p['nome']} | Email: {p['email']} | Idade: {p['idade']}")

def atualizar():
    listar()
    indice = int(input("Digite o índice da pessoa para atualizar: "))
    if 0 <= indice < len(pessoas):
        nome = input("Novo nome: ")
        email = input("Novo email: ")
        idade = int(input("Nova idade: "))
        pessoas[indice].update({"nome": nome, "email": email, "idade": idade})
        print("Cadastro atualizado com sucesso!\n")
    else:
        print("Índice inválido!\n")

def excluir():
    listar()
    indice = int(input("Digite o índice da pessoa para excluir: "))
    if 0 <= indice < len(pessoas):
        confirmacao = input(f"Tem certeza que deseja excluir {pessoas[indice]['nome']}? (s/n): ").lower()
        if confirmacao == "s":
            pessoas.pop(indice)
            print("Pessoa excluída com sucesso!\n")
        else:
            print("Exclusão cancelada.\n")
    else:
        print("Índice inválido!\n")

def menu():
    while True:
        print("1 - Cadastrar")
        print("2 - Listar")
        print("3 - Atualizar")
        print("4 - Excluir")
        print("5 - Sair")
        opcao = input("Escolha uma opção: ")

        if opcao == "1":
            cadastrar()
        elif opcao == "2":
            listar()
        elif opcao == "3":
            atualizar()
        elif opcao == "4":
            excluir()
        elif opcao == "5":
            break
        else:
            print("Opção inválida!\n")

if __name__ == "__main__":
    menu()

