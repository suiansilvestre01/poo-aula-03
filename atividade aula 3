# atividade.py

class Emprestimo:
    def __init__(self, valor, quitado=False):
        self.valor = valor
        self.quitado = quitado

    def __str__(self):
        status = "Quitado" if self.quitado else "Pendente"
        return f"Empréstimo de R$ {self.valor:.2f} - {status}"


class Cliente:
    def __init__(self, nome):
        self.nome = nome
        self.emprestimos = []

    def adicionar_emprestimo(self, valor):
        emprestimo = Emprestimo(valor)
        self.emprestimos.append(emprestimo)

    def listar_emprestimos(self):
        if not self.emprestimos:
            print("Nenhum empréstimo registrado.")
        else:
            for e in self.emprestimos:
                print(e)

    def pode_receber_novo(self):
        pendentes = [e for e in self.emprestimos if not e.quitado]
        total_divida = sum(e.valor for e in pendentes)

        if len(pendentes) >= 2 or total_divida > 10000:
            return False
        return True


def menu():
    clientes = []

    while True:
        print("\n--- Menu ---")
        print("1 - Cadastrar cliente")
        print("2 - Adicionar empréstimo")
        print("3 - Listar clientes e empréstimos")
        print("4 - Verificar se cliente pode receber novo empréstimo")
        print("5 - Sair")
        opcao = input("Escolha uma opção: ")

        if opcao == "1":
            nome = input("Nome do cliente: ")
            clientes.append(Cliente(nome))
            print("Cliente cadastrado com sucesso!")

        elif opcao == "2":
            if not clientes:
                print("Nenhum cliente cadastrado!")
                continue
            for i, c in enumerate(clientes):
                print(f"{i} - {c.nome}")
            indice = int(input("Escolha o cliente: "))
            valor = float(input("Valor do empréstimo: "))
            clientes[indice].adicionar_emprestimo(valor)
            print("Empréstimo adicionado com sucesso!")

        elif opcao == "3":
            if not clientes:
                print("Nenhum cliente cadastrado!")
            else:
                for c in clientes:
                    print(f"\nCliente: {c.nome}")
                    c.listar_emprestimos()

        elif opcao == "4":
            for c in clientes:
                status = "APTO" if c.pode_receber_novo() else "NÃO APTO"
                print(f"Cliente {c.nome} está {status} para novo empréstimo.")

        elif opcao == "5":
            break

        else:
            print("Opção inválida!")


if __name__ == "__main__":
    menu()
